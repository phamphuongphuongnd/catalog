{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phamphuongphuongnd.github.io/catalog/schema/subnest-v4.schema.json",
  "title": "Subnest service catalog v4",
  "description": "Remote catalog for Subnest: services, plans and suggested prices per region. Rules JSON Schema cannot express (unique ids, currency matches region, never delete published ids) are enforced by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "updatedAt", "staleAfterDays", "regions", "services"],
  "properties": {
    "schemaVersion": { "const": 4, "description": "Schema version. Breaking changes publish under a new path (subnest/v2/)." },
    "version": { "type": "integer", "minimum": 1, "description": "Data version; increases whenever the data changes. Continues the bundled v1-v3 numbering." },
    "updatedAt": { "$ref": "#/$defs/date" },
    "staleAfterDays": { "const": 90, "description": "A price whose verifiedAt is older than this (or missing) is approximate." },
    "regions": {
      "type": "object",
      "description": "Region code -> default currency. UK is used for the United Kingdom (ISO 3166 'GB').",
      "additionalProperties": false,
      "required": ["VN", "US", "UK", "AU", "CA", "IN"],
      "properties": {
        "VN": { "const": "VND" }, "US": { "const": "USD" }, "UK": { "const": "GBP" },
        "AU": { "const": "AUD" }, "CA": { "const": "CAD" }, "IN": { "const": "INR" }
      }
    },
    "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/service" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "color", "monogram", "market", "logoDomain", "aliases", "cancelUrl", "manageUrl", "plans"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Stable key, never changed or reused." },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["video", "music", "ai", "storage", "software", "gaming", "reading", "health", "education", "telecom", "other"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "monogram": { "type": "string", "minLength": 1, "maxLength": 2 },
        "market": { "enum": ["global", "vn"] },
        "logoDomain": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$", "description": "Host name for logo.dev, e.g. netflix.com." },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "cancelUrl": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "manageUrl": { "oneOf": [{ "$ref": "#/$defs/httpsUrl" }, { "type": "null" }] },
        "plans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plan" } },
        "note": { "type": "string", "description": "Maintainer note (Vietnamese). Not shown in the app; absent from services.min.json." }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "cycle", "prices"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "closed_to_new", "discontinued"] },
        "renamedFrom": { "type": "string", "minLength": 1, "description": "Previous display name if the provider renamed the plan (id unchanged)." },
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "count"],
          "properties": { "unit": { "enum": ["day", "week", "month", "year"] }, "count": { "type": "integer", "minimum": 1 } }
        },
        "members": { "type": "integer", "minimum": 2 },
        "prices": {
          "type": "object",
          "propertyNames": { "enum": ["VN", "US", "UK", "AU", "CA", "IN"] },
          "additionalProperties": { "$ref": "#/$defs/price" }
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount", "method"],
      "dependentRequired": { "verifiedAt": ["source"], "source": ["verifiedAt"] },
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "amount": { "type": "number", "exclusiveMinimum": 0, "description": "Major units (74000 = 74.000 VND, 12.99 = $12.99)." },
        "verifiedAt": { "$ref": "#/$defs/date" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "method": { "enum": ["aristocles", "vn-parser", "manual"] }
      }
    }
  }
}
